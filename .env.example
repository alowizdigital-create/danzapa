# Variables d'environnement lues par config/settings.py.
# À définir dans le shell ou chez l'hébergeur ; toutes sont optionnelles
# en développement.
# En production : DJANGO_DEBUG=false et une vraie DJANGO_SECRET_KEY.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/Paris

# PostgreSQL (optionnel, SQLite par défaut)
# DATABASE_ENGINE=postgresql
# DATABASE_NAME=danzapa
# DATABASE_USER=danzapa
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
