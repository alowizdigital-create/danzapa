# Variables d'environnement lues par config/settings.py.
# Développement : toutes optionnelles.
# Production : les réglages courants sont dans config/production.env (versionné,
# sans secret). Les variables ci-dessous, définies dans l'onglet « Environment »
# de Dokploy, sont prioritaires sur ce fichier.

# Optionnelle : générée automatiquement dans DATA_DIR/secret_key si absente.
DJANGO_SECRET_KEY=

# Nom(s) de domaine du site, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=danzapa.exemple.org

# Fuseau horaire de l'église (dates et heures affichées).
DJANGO_TIME_ZONE=Europe/Paris

# Premier compte administrateur, créé au premier démarrage s'il n'existe pas.
# Sans mot de passe, un mot de passe provisoire est affiché dans les logs.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Déjà réglés dans l'image Docker ; utiles hors Docker.
# DJANGO_DEBUG=false
# DATA_DIR=/data

# Optionnels
# DJANGO_CSRF_TRUSTED_ORIGINS=https://danzapa.exemple.org   (déduit de ALLOWED_HOSTS par défaut)
# GUNICORN_WORKERS=3
# DJANGO_HSTS_SECONDS=31536000                              (une fois le HTTPS confirmé)

# PostgreSQL : base séparée, recommandée en production (Dokploy → Database →
# PostgreSQL → « Internal Connection URL »). À mettre dans Dokploy uniquement.
# DATABASE_URL=postgresql://danzapa:motdepasse@danzapa-db-xxxx:5432/danzapa

# Ou, variable par variable (SQLite dans /data si rien n'est défini)
# DATABASE_ENGINE=postgresql
# DATABASE_NAME=danzapa
# DATABASE_USER=danzapa
# DATABASE_PASSWORD=
# DATABASE_HOST=
# DATABASE_PORT=5432
