# Variables d'environnement lues par config/settings.py.
# Développement : toutes optionnelles.
# Production (Dokploy) : à coller dans l'onglet « Environment » (voir DEPLOIEMENT.md).

# Obligatoire en production. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Nom(s) de domaine du site, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=danzapa.exemple.org

# Fuseau horaire de l'église (dates et heures affichées).
DJANGO_TIME_ZONE=Europe/Paris

# Premier compte administrateur, créé au premier démarrage s'il n'existe pas.
# Retirer le mot de passe une fois connecté (il n'est plus utilisé ensuite).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Déjà réglés dans l'image Docker ; utiles hors Docker.
# DJANGO_DEBUG=false
# DATA_DIR=/data

# Optionnels
# DJANGO_CSRF_TRUSTED_ORIGINS=https://danzapa.exemple.org   (déduit de ALLOWED_HOSTS par défaut)
# GUNICORN_WORKERS=3
# DJANGO_HSTS_SECONDS=31536000                              (une fois le HTTPS confirmé)

# PostgreSQL (optionnel ; SQLite dans /data par défaut)
# DATABASE_ENGINE=postgresql
# DATABASE_NAME=danzapa
# DATABASE_USER=danzapa
# DATABASE_PASSWORD=
# DATABASE_HOST=
# DATABASE_PORT=5432
