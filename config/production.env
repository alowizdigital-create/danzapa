# Réglages de Danzapa en production : à modifier ici, puis « Deploy » dans Dokploy.
#
# Ce dépôt est PUBLIC : n'écrivez JAMAIS de mot de passe ni de clé secrète dans
# ce fichier. La clé secrète est générée automatiquement sur le serveur, et le
# mot de passe du premier administrateur s'affiche dans les logs de Dokploy.
#
# Une variable définie dans l'onglet « Environment » de Dokploy est prioritaire
# sur la valeur de ce fichier.

# Adresse du site (sans https:// ni / final). Plusieurs : séparées par des virgules.
DJANGO_ALLOWED_HOSTS=danzapa.zweey.com

# Fuseau horaire de l'église, pour les dates et heures affichées.
# Exemples : Africa/Kinshasa, Africa/Lubumbashi, Africa/Abidjan, Africa/Douala, Europe/Paris
DJANGO_TIME_ZONE=Europe/Paris

# Identifiant du premier administrateur, créé au premier démarrage.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
